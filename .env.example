# Copia este archivo como .env (NO subir .env a Git). En Render se ponen en el servicio → Environment.

# --- CORS ------------------------------------------------------------------------
# Orígenes extra separados por coma (se suman a localhost, capacitor://localhost, etc.)
# En producción: la URL de la app. Ejemplo: https://app.tu-dominio.com
CHROMA_CORS_ORIGINS=
# En desarrollo se aceptan IPs de red local (celular -> PC). Pon 0 en producción.
CHROMA_ALLOW_LAN=1

# --- Supabase: planes, cuotas y catálogo ----------------------------------------------
# Supabase → Project Settings → API. Son los mismos valores públicos que usa la app.
# Si se dejan vacíos, los planes quedan desactivados (todas las marcas, sin cuotas) y el catálogo sale del CSV.
CHROMA_SUPABASE_URL=
CHROMA_SUPABASE_PUBLISHABLE_KEY=
# csv = usar data/productos_mvp.csv aunque Supabase esté configurado (vacío = Supabase si está configurado)
CHROMA_CATALOG_SOURCE=

# --- Pagos con Wompi (migración 005) ------------------------------------------------
# SOLO en el servidor (Render), nunca en la app. Sin estas llaves los pagos quedan desactivados.
# Supabase → Project Settings → API → service_role (secreta: confirma pagos y activa planes).
CHROMA_SUPABASE_SERVICE_ROLE_KEY=
# Wompi → Desarrolladores. Para pruebas usa las llaves que empiezan por pub_test_ / test_.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# Adonde vuelve la usuaria después de pagar (la app publicada). Se agrega /planes.
CHROMA_APP_URL=http://localhost:8101
# Precios en COP al mes (vacío = los del modelo financiero: Plus 19900, Premium 34900)
CHROMA_PRICE_PLUS=
CHROMA_PRICE_PREMIUM=

# --- Correos con Resend ----------------------------------------------------------------
# Confirmación de pago. Sin la llave no se envía nada. El remitente debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
CHROMA_EMAIL_FROM=Chroma <hola@tu-dominio.com>

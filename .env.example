# Orígenes extra separados por coma (se suman a localhost:5173/8100, capacitor://localhost, etc.)
# Ejemplo: CHROMA_CORS_ORIGINS=https://mi-app.vercel.app,https://abc123.ngrok-free.app
CHROMA_CORS_ORIGINS=
# En desarrollo se aceptan IPs de red local (celular -> PC). Pon 0 en producción.
CHROMA_ALLOW_LAN=1
